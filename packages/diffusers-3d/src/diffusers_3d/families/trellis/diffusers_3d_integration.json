      },
      "class_name": "diffusers_3d.families.trellis.conditioner.TrellisDinov2Conditioner",
      "parity": [
        {
          "atol": 0.0,
          "kind": "inference",
          "passed": true,
          "reference": "Released ImageNet normalization, class/register/patch token order, x_prenorm encoder output, and unparameterized final layer normalization equations on a tiny CPU model.",
          "rtol": 0.0,
          "test": "tests/families/trellis/test_conditioner.py::test_trellis_dinov2_normalization_register_tokens_and_save_load"
        }
      ],
      "role": "conditioner"
    },
    {
      "checkpoint_conversion": {
        "converter": "diffusers_3d.families.trellis.conversion.convert_trellis_checkpoint",
        "source_format": "upstream-component-json-safetensors",
        "target_format": "diffusers-pipeline-object3d-v2",
        "test": "tests/families/trellis/test_conversion.py::test_synthetic_conversion_converts_slat_components_and_auto_loads"
      },
